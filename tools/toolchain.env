# toolchain.env — the pinned versions of every binary the gates need. ONE source of truth, sourced by
# `tools/install-toolchain.sh`, which is in turn used by both `.github/workflows/gates.yml` and
# `.claude/hooks/session-start.sh`. Before this file the two disagreed: CI pinned Lune 0.10.5 from a
# prebuilt release while the hook ran `cargo install lune --locked` — unpinned, and a from-source
# build that cost minutes of every session start. A gate that runs a different toolchain locally than
# it does in CI is not a gate.
#
# Bumping a version: change it here, run `tools/gates.sh` locally, and note it in the PR. Nothing
# else references these numbers.

# The headless Luau runtime. Runs the unit tests and every tool in tools/.
LUNE_VERSION=0.10.5

# The type checker (`luau-lsp analyze`). Roblox's own analysis engine, run against src/ (ADR 0011).
LUAU_LSP_VERSION=1.58.0

# Rojo. Syncs src/ into Studio, and — the reason the gates need it — emits the instance sourcemap
# that teaches the type checker what `script.Parent.Constants` resolves to.
ROJO_VERSION=7.4.4

# Roblox API type definitions for the type checker. Tracked separately from luau-lsp because it is a
# generated artifact fetched by URL rather than a release binary; `main` is the only branch upstream
# publishes it on, so the pin here is the SHA the checksum below was taken against.
GLOBAL_TYPES_URL=https://raw.githubusercontent.com/JohnnyMorganz/luau-lsp/main/scripts/globalTypes.d.luau
