# Rojo / Studio build output. A place file is a multi-megabyte binary that changes on every save and
# never merges — it is a build artifact of src/, not a source of it.
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
*.rbxl.lock
*.rbxlx.lock
build/

# Generated by `tools/gates.sh typecheck` (rojo sourcemap) on every run. Derived from
# default.project.json + the src/ tree, so committing it would only ever be a stale copy.
sourcemap.json

# The pinned toolchain, when installed inside the repo instead of ~/.joust-tools.
.joust-tools/

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp
